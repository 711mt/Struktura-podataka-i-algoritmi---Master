def palindrom(s):
    if len(s) <= 1:
        return True
    # Ako se prvo i poslednje slovo razlikuju, nije palindrom
    if s[0] != s[-1]:
        return False
    return palindrom(s[1:-1])

# Test
print(palindrom("anavolimilovana")) 
print(palindrom("radar"))            
print(palindrom("zdravo"))           
print(palindrom("a"))                
print(palindrom(""))      

