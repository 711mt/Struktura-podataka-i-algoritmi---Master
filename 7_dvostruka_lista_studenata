class StudentNode:
    def __init__(self, ime, prezime, godina, prosjek):
        self.ime = ime
        self.prezime = prezime
        self.godina = godina
        self.prosjek = prosjek
        self.prev = None    
        self.next = None      
class StudentLista:
    def __init__(self):
        self.head = None  
        self.tail = None       
    
    def append(self, ime, prezime, godina, prosjek):
        novi = StudentNode(ime, prezime, godina, prosjek)
        if self.head is None:              
            self.head = novi
            self.tail = novi
            return
        novi.prev = self.tail              
        self.tail.next = novi               
        self.tail = novi                    
    
    def stampaj(self):
        t = self.head
        while t is not None:
            print(f"  [{t.ime} {t.prezime}, god.{t.godina}, prosjek {t.prosjek}]")
            t = t.next
    def studenti_iznad_prosjeka(self, granica):
        rezultat = []
        broj = 0
        t = self.head
        while t is not None:
            if t.prosjek > granica:
                rezultat.append(t)
                broj += 1
            t = t.next
        return rezultat, broj
    def stampa_prije_indeksa_unazad(self, indeks):
        t = self.head
        trenutni_indeks = 0
        while t is not None and trenutni_indeks < indeks:
            t = t.next
            trenutni_indeks += 1
        if t is None:
            print("Indeks van opsega.")
            return
        elementi = []
        p = t.prev
        while p is not None:
            elementi.append(f"{p.ime} {p.prezime}")
            p = p.prev
        print(" - ".join(elementi) if elementi else "(nema elemenata prije indeksa)")


# === TEST ===
lista = StudentLista()
lista.append("Marija",  "Tomović",   2, 9.5)
