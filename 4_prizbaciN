# Verzija 1 
class DoublyLinkedList:
    def __init__(self):
        self.head = None
        self.tail = None
    
    def append(self, data):
        novi = Node(data)
        if self.head is None:
            self.head = novi
            self.tail = novi
            return
        novi.prev = self.tail
        self.tail.next = novi
        self.tail = novi
    
    def stampa_normalno(self):
        t = self.head
        elementi = []
        while t is not None:
            elementi.append(str(t.data))
            t = t.next
        print(" <-> ".join(elementi) if elementi else "(prazna lista)")
    
    def prizbaciN(self, N):
        # Granični slučajevi
        if N <= 0 or self.head is None:
            return 0
        izbaceno = 0
        trenutni = self.tail
        while izbaceno < N and trenutni is not None:
            trenutni = trenutni.prev  
            izbaceno += 1
        if trenutni is None:
            self.head = None
            self.tail = None
        else:
            self.tail = trenutni
            self.tail.next = None       
        return izbaceno


# Verzija 2
def prizbaciN(head, tail, N):
    if N <= 0 or head is None:
        return head, tail, 0
    
    izbaceno = 0
    trenutni = tail
    
    while izbaceno < N and trenutni is not None:
        trenutni = trenutni.prev
        izbaceno += 1
    
    if trenutni is None:
        return None, None, izbaceno    
    
    trenutni.next = None                
    return head, trenutni, izbaceno
lista = DoublyLinkedList()
