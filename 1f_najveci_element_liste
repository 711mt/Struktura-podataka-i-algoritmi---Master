# funkcija koja rekurzivno pronalazi najveci element u listi brojeva
def najveci(lista):
    if len(lista) == 1:
        return lista[0]
    najveci_ostatak = najveci(lista[1:])
  
    if lista[0] > najveci_ostatak:
        return lista[0]
    else:
        return najveci_ostatak


# Test
print(najveci([3, 1, 4, 1, 5, 9, 2, 6]))
print(najveci([-10, -2, -7]))            
print(najveci([42]))                       

